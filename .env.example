# MediBridge AI configuration. scripts/setup.ps1 copies this to .env and fills every CHANGE_ME with a random secret.
# Never commit .env.

# --- Environment ---
MEDIBRIDGE_ENV=local
MEDIBRIDGE_API_HOST=127.0.0.1
MEDIBRIDGE_API_PORT=8000
MEDIBRIDGE_WEB_ORIGIN=http://127.0.0.1:5173
MEDIBRIDGE_SESSION_SECRET=CHANGE_ME
# Session lifetimes (minutes). OWASP guidance for high-value apps: short idle timeout, bounded absolute lifetime.
MEDIBRIDGE_SESSION_IDLE_MINUTES=30
MEDIBRIDGE_SESSION_ABSOLUTE_MINUTES=480
# auto = Secure cookies only over HTTPS; 1 = always; 0 = never (local http only)
MEDIBRIDGE_SECURE_COOKIES=auto

# --- PostgreSQL (docker, 127.0.0.1:5433; 5432 is left to another local Postgres) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=medibridge
POSTGRES_OWNER_USER=medibridge_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
POSTGRES_APP_USER=medibridge_app
POSTGRES_APP_PASSWORD=CHANGE_ME

# --- Qdrant (docker, 127.0.0.1:6333) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=CHANGE_ME

# --- Neo4j (docker, bolt 127.0.0.1:7688; 7687 is left to another local Neo4j) ---
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_PASSWORD=CHANGE_ME

# --- Local AI ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL_CLINICAL=qwen3.5:9b
LLM_MODEL_LIGHT=qwen3.5:4b
EMBEDDING_MODEL=bge-m3
# Optional cross-encoder re-ranking of hybrid (BM25 + dense, RRF) document search. Empty = off (default): on the
# cardiology benchmark it did not improve ranking (docs/evaluation.md). To try it: jinaai/jina-reranker-v1-tiny-en
RERANKER_MODEL=
ASR_MODEL=small.en
ASR_COMPUTE_TYPE=int8
# Hosted providers are refused unless BOTH of these are set and an approved deployment is recorded.
ALLOW_HOSTED_PHI=false
HOSTED_PHI_APPROVAL_REF=

# --- Storage ---
DOCUMENT_STORE_DIR=var/documents
AUDIO_STORE_DIR=var/audio

# --- Observability ---
# External tracing is OFF by default. If enabled, only redacted metadata (ids, timings, statuses) is sent.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medibridge-demo

# --- Agent-to-agent (A2A) ---
# a2a: each specialist agent is a separate local service (ports A2A_BASE_PORT..+7), called over A2A JSON-RPC.
# inprocess: agents run inside the API process (debugging only).
AGENT_TRANSPORT=a2a
# Signs the short-lived capability tokens the supervisor gives each agent call.
MEDIBRIDGE_A2A_SECRET=CHANGE_ME
A2A_HOST=127.0.0.1
A2A_BASE_PORT=8101
A2A_CALL_TIMEOUT_S=1500
A2A_TOKEN_TTL_S=120
